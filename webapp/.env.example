# Web front office configuration (copy values to your environment or .env)

# Required in production: long random session signing key
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# ARATI_WEB_SECRET=change-me

# Database URL (defaults to sqlite file webapp/data/arati_web.db)
# ARATI_WEB_DATABASE_URL=sqlite:///C:/path/to/arati_web.db
# ARATI_WEB_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# Production mode: disables demo seed unless ARATI_SEED_DEMO=1
# ARATI_ENV=production
# ARATI_WEB_HTTPS=1
# ARATI_SEED_DEMO=0

# First admin account on a fresh production database (password >= 12 chars)
# ARATI_INITIAL_ADMIN_USER=admin
# ARATI_INITIAL_ADMIN_PASSWORD=change-this-strong-password

# Server
# ARATI_WEB_HOST=0.0.0.0
# ARATI_WEB_PORT=8000

# Reports / scheduler
# ARATI_WEB_REPORT_DIRECTORY=webapp/data/reports
# ARATI_WEB_DAILY_CLOSE_ENABLED=1
