# Cloud KOT sync — environment template
#
# Copy the values you need into your shell (or into `.env` and start the webapp
# with `uvicorn --env-file .env`). Nothing here is enabled until
# KOT_CLOUD_URL, KOT_CLOUD_USERNAME and KOT_CLOUD_PASSWORD are all set.
# See KOT_SYNC.md for the full setup and rollback instructions.

# Master switch. 0 disables the integration even when everything below is set.
ARATI_WEB_KOT_SYNC=1

# The Render service that hosts the KOT / kitchen app (no trailing slash).
KOT_CLOUD_URL=https://arati-kot.onrender.com

# Service account on the cloud app. It must have the admin role, because menu
# pushes use the admin-only dish endpoints. Use a dedicated account, not a
# person's login.
KOT_CLOUD_USERNAME=kot-sync
KOT_CLOUD_PASSWORD=change-me

# One cycle every N seconds (15-3600, default 60). The free Render instance
# sleeps when idle; the first cycle after a cold start can take ~30s.
KOT_POLL_SECONDS=60

# Tickets fetched per page (10-500, default 100).
KOT_SYNC_PAGE_SIZE=100

# HTTP timeout in seconds (3-120, default 30).
KOT_SYNC_TIMEOUT=15

# How many still-open cloud tickets are re-read each cycle to catch status
# changes (0-200, default 25). The rest come through the id cursor.
KOT_OPEN_REFRESH_LIMIT=25

# Push the local admin menu to the cloud app (no deletes are ever sent).
KOT_PUSH_MENU=1

# Push local hotel rooms to the cloud app as selectable tables (room service).
KOT_PUSH_ROOMS=1

# Push local KOTs that were cut in this webapp to the cloud app.
KOT_PUSH_ORDERS=1

# Only local KOTs in these statuses are pushed.
KOT_PUSH_ORDER_STATUSES=new,preparing,ready,served
