# Render Deployment - Environment Variables
# Copy to Render Dashboard → Environment → Add Environment Variable

# REQUIRED - Generate a strong secret (run: python -c 'import secrets; print(secrets.token_hex(32))')
ARATI_WEB_SECRET=your-64-char-hex-secret-here

# Database - Uses Render persistent disk (sqlite:///data/arati_web.db)
ARATI_WEB_DATABASE_URL=sqlite:///data/arati_web.db

# HTTPS - Render provides HTTPS automatically
ARATI_WEB_HTTPS=1

# Optional - Daily close scheduler (enabled by default)
ARATI_WEB_DAILY_CLOSE_ENABLED=1

# Optional - Reports directory on persistent disk
ARATI_WEB_REPORT_DIRECTORY=/opt/render/project/src/data/reports

# WhatsApp (optional - for order assistant)
# ARATI_WHATSAPP_TOKEN=
# ARATI_WHATSAPP_PHONE_NUMBER_ID=
# ARATI_WHATSAPP_VERIFY_TOKEN=
# ARATI_WHATSAPP_APP_SECRET=

# Python version
PYTHON_VERSION=3.11.10